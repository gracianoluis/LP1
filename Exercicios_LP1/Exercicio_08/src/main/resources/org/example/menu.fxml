<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="400.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.MenuController">
    <children>
        <Label layoutX="216.0" layoutY="44.0" text="Menu Principal">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <Button layoutX="225.0" layoutY="120.0" mnemonicParsing="false"
                onAction="#irParaFrutas" prefHeight="40.0" prefWidth="150.0" text="Cadastro de Frutas" />

        <Button layoutX="225.0" layoutY="180.0" mnemonicParsing="false"
                onAction="#irParaMedicamentos" prefHeight="40.0" prefWidth="150.0" text="Medicamentos" />

        <Button layoutX="225.0" layoutY="240.0" mnemonicParsing="false"
                onAction="#irParaServicos" prefHeight="40.0" prefWidth="150.0" text="Serviços" />
    </children>
</AnchorPane>