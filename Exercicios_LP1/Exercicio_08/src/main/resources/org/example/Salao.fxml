<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.salao.controllers.SalaoController">
    <children>
        <Label layoutX="21.0" layoutY="15.0" text="Salão">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>
        <Button layoutX="450.0" layoutY="15.0" mnemonicParsing="false" onAction="#voltarMenu" text="Voltar ao Menu" />

        <TabPane layoutY="60.0" prefHeight="440.0" prefWidth="600.0" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab text="Cadastrar Serviços">
                    <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                        <children>
                            <Label layoutX="30.0" layoutY="30.0" text="Descrição do Serviço:" />
                            <TextField fx:id="txtDescricaoServico" layoutX="180.0" layoutY="26.0" prefWidth="250.0" />

                            <Label layoutX="30.0" layoutY="70.0" text="Valor (R$):" />
                            <TextField fx:id="txtValorServico" layoutX="180.0" layoutY="66.0" prefWidth="250.0" />

                            <Label layoutX="30.0" layoutY="110.0" text="Tempo Estimado (min):" />
                            <TextField fx:id="txtTempoServico" layoutX="180.0" layoutY="106.0" prefWidth="250.0" />

                            <Button layoutX="180.0" layoutY="160.0" mnemonicParsing="false" onAction="#cadastrarServico" text="Salvar Serviço no Sistema" />
                            <Label fx:id="lblStatusServico" layoutX="180.0" layoutY="200.0" textFill="GREEN">
                                <font><Font name="System Bold" size="12.0" /></font>
                            </Label>
                        </children>
                    </AnchorPane>
                </Tab>

                <Tab text="Cadastrar Cabeleireiros">
                    <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                        <children>
                            <Label layoutX="30.0" layoutY="30.0" text="Nome do Profissional:" />
                            <TextField fx:id="txtNomeCabeleireiro" layoutX="180.0" layoutY="26.0" prefWidth="250.0" />

                            <Label layoutX="30.0" layoutY="70.0" text="Especialidade:" />
                            <TextField fx:id="txtEspecialidadeCabeleireiro" layoutX="180.0" layoutY="66.0" prefWidth="250.0" promptText="Ex: Coloração, Cortes..." />

                            <Label layoutX="30.0" layoutY="110.0" text="Comissão Atual (R$):" />
                            <TextField fx:id="txtComissaoCabeleireiro" layoutX="180.0" layoutY="106.0" prefWidth="250.0" />

                            <Button layoutX="180.0" layoutY="160.0" mnemonicParsing="false" onAction="#cadastrarCabeleireiro" text="Salvar Cabeleireiro no Sistema" />
                            <Label fx:id="lblStatusCabeleireiro" layoutX="180.0" layoutY="200.0" textFill="GREEN">
                                <font><Font name="System Bold" size="12.0" /></font>
                            </Label>
                        </children>
                    </AnchorPane>
                </Tab>

                <Tab text="Registrar Produtos">
                    <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                        <children>
                            <Label layoutX="30.0" layoutY="30.0" text="Marca do Produto:" />
                            <TextField fx:id="txtMarcaProduto" layoutX="180.0" layoutY="26.0" prefWidth="250.0" />

                            <Label layoutX="30.0" layoutY="70.0" text="Função:" />
                            <TextField fx:id="txtFuncaoProduto" layoutX="180.0" layoutY="66.0" prefWidth="250.0" promptText="Ex: Hidratação, Limpeza..." />

                            <Label layoutX="30.0" layoutY="110.0" text="Quantidade (ml):" />
                            <TextField fx:id="txtQuantidadeProduto" layoutX="180.0" layoutY="106.0" prefWidth="250.0" />

                            <Button layoutX="180.0" layoutY="160.0" mnemonicParsing="false" onAction="#cadastrarProduto" text="Salvar Produto no Sistema" />
                            <Label fx:id="lblStatusProduto" layoutX="180.0" layoutY="200.0" textFill="GREEN">
                                <font><Font name="System Bold" size="12.0" /></font>
                            </Label>
                        </children>
                    </AnchorPane>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</AnchorPane>
