<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.feira.controllers.FeiraController">
    <children>
        <Label layoutX="20.0" layoutY="15.0" text="Feira">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>
        <Button layoutX="450.0" layoutY="15.0" mnemonicParsing="false" onAction="#voltarMenu" text="Voltar ao Menu" />

        <TabPane layoutY="60.0" prefHeight="440.0" prefWidth="600.0" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab text="Cadastrar Frutas">
                    <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                        <children>
                            <Label layoutX="30.0" layoutY="30.0" text="Tipo da Fruta:" />
                            <TextField fx:id="txtTipoFruta" layoutX="150.0" layoutY="26.0" prefWidth="250.0" />

                            <Label layoutX="30.0" layoutY="70.0" text="Preço por Quilo:" />
                            <TextField fx:id="txtPrecoFruta" layoutX="150.0" layoutY="66.0" prefWidth="250.0" />

                            <Label layoutX="30.0" layoutY="110.0" text="Peso no Estoque:" />
                            <TextField fx:id="txtPesoFruta" layoutX="150.0" layoutY="106.0" prefWidth="250.0" />

                            <Button layoutX="150.0" layoutY="160.0" mnemonicParsing="false" onAction="#cadastrarFruta" text="Salvar Fruta no Sistema" />
                            <Label fx:id="lblStatusFruta" layoutX="150.0" layoutY="200.0" textFill="GREEN">
                                <font><Font name="System Bold" size="12.0" /></font>
                            </Label>
                        </children>
                    </AnchorPane>
                </Tab>

                <Tab text="Cadastrar Feirantes">
                    <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                        <children>
                            <Label layoutX="30.0" layoutY="30.0" text="Nome do Feirante:" />
                            <TextField fx:id="txtNomeFeirante" layoutX="180.0" layoutY="26.0" prefWidth="250.0" />

                            <Label layoutX="30.0" layoutY="70.0" text="Número da Barraca:" />
                            <TextField fx:id="txtNumeroBarraca" layoutX="180.0" layoutY="66.0" prefWidth="250.0" />

                            <Label layoutX="30.0" layoutY="110.0" text="Faturamento Diário:" />
                            <TextField fx:id="txtFaturamentoDiario" layoutX="180.0" layoutY="106.0" prefWidth="250.0" />

                            <Button layoutX="180.0" layoutY="160.0" mnemonicParsing="false" onAction="#cadastrarFeirante" text="Salvar Feirante no Sistema" />
                            <Label fx:id="lblStatusFeirante" layoutX="180.0" layoutY="200.0" textFill="GREEN">
                                <font><Font name="System Bold" size="12.0" /></font>
                            </Label>
                        </children>
                    </AnchorPane>
                </Tab>

                <Tab text="Registrar Balanças">
                    <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                        <children>
                            <Label layoutX="30.0" layoutY="30.0" text="Marca da Balança:" />
                            <TextField fx:id="txtMarcaBalanca" layoutX="170.0" layoutY="26.0" prefWidth="250.0" />

                            <Label layoutX="30.0" layoutY="70.0" text="Peso Máximo (kg):" />
                            <TextField fx:id="txtPesoMaximo" layoutX="170.0" layoutY="66.0" prefWidth="250.0" />

                            <CheckBox fx:id="chkEstaCalibrada" layoutX="170.0" layoutY="110.0" mnemonicParsing="false" text="A balança está calibrada?" />

                            <Button layoutX="170.0" layoutY="160.0" mnemonicParsing="false" onAction="#cadastrarBalanca" text="Salvar Balança no Sistema" />
                            <Label fx:id="lblStatusBalanca" layoutX="170.0" layoutY="200.0" textFill="GREEN">
                                <font><Font name="System Bold" size="12.0" /></font>
                            </Label>
                        </children>
                    </AnchorPane>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</AnchorPane>
