<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.farmacia.controllers.FarmaciaController">
   <children>
      <Label layoutX="20.0" layoutY="15.0" text="Farmácia">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <Button layoutX="450.0" layoutY="15.0" mnemonicParsing="false" onAction="#voltarMenu" text="Voltar ao Menu" />

      <TabPane layoutY="60.0" prefHeight="440.0" prefWidth="600.0" tabClosingPolicy="UNAVAILABLE">
         <tabs>
            <Tab text="Cadastrar Medicamentos">
               <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                  <children>
                     <Label layoutX="30.0" layoutY="30.0" text="Nome do Medicamento:" />
                     <TextField fx:id="txtNomeMedicamento" layoutX="180.0" layoutY="26.0" prefWidth="250.0" />

                     <Label layoutX="30.0" layoutY="70.0" text="Preço (R$):" />
                     <TextField fx:id="txtPrecoMedicamento" layoutX="180.0" layoutY="66.0" prefWidth="250.0" />

                     <CheckBox fx:id="chkExigeReceita" layoutX="180.0" layoutY="110.0" mnemonicParsing="false" text="Exige Receita Médica?" />

                     <Button layoutX="180.0" layoutY="160.0" mnemonicParsing="false" onAction="#cadastrarMedicamento" text="Salvar Medicamento no Sistema" />
                     <Label fx:id="lblStatusMedicamento" layoutX="180.0" layoutY="200.0" textFill="GREEN">
                        <font><Font name="System Bold" size="12.0" /></font>
                     </Label>
                  </children>
               </AnchorPane>
            </Tab>

            <Tab text="Cadastrar Clientes">
               <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                  <children>
                     <Label layoutX="30.0" layoutY="30.0" text="Nome do Cliente:" />
                     <TextField fx:id="txtNomeCliente" layoutX="180.0" layoutY="26.0" prefWidth="250.0" />

                     <Label layoutX="30.0" layoutY="70.0" text="CPF:" />
                     <TextField fx:id="txtCpfCliente" layoutX="180.0" layoutY="66.0" prefWidth="250.0" />

                     <Label layoutX="30.0" layoutY="110.0" text="Pontos de Fidelidade:" />
                     <TextField fx:id="txtPontosFidelidade" layoutX="180.0" layoutY="106.0" prefWidth="250.0" />

                     <Button layoutX="180.0" layoutY="160.0" mnemonicParsing="false" onAction="#cadastrarCliente" text="Salvar Cliente no Sistema" />
                     <Label fx:id="lblStatusCliente" layoutX="180.0" layoutY="200.0" textFill="GREEN">
                        <font><Font name="System Bold" size="12.0" /></font>
                     </Label>
                  </children>
               </AnchorPane>
            </Tab>

            <Tab text="Cadastrar Farmacêuticos">
               <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                  <children>
                     <Label layoutX="30.0" layoutY="30.0" text="Nome do Profissional:" />
                     <TextField fx:id="txtNomeFarmaceutico" layoutX="180.0" layoutY="26.0" prefWidth="250.0" />

                     <Label layoutX="30.0" layoutY="70.0" text="Nº de Registro (CRF):" />
                     <TextField fx:id="txtCrfFarmaceutico" layoutX="180.0" layoutY="66.0" prefWidth="250.0" />

                     <Label layoutX="30.0" layoutY="110.0" text="Salário Base (R$):" />
                     <TextField fx:id="txtSalarioFarmaceutico" layoutX="180.0" layoutY="106.0" prefWidth="250.0" />

                     <Button layoutX="180.0" layoutY="160.0" mnemonicParsing="false" onAction="#cadastrarFarmaceutico" text="Salvar Farmacêutico no Sistema" />
                     <Label fx:id="lblStatusFarmaceutico" layoutX="180.0" layoutY="200.0" textFill="GREEN">
                        <font><Font name="System Bold" size="12.0" /></font>
                     </Label>
                  </children>
               </AnchorPane>
            </Tab>
         </tabs>
      </TabPane>
   </children>
</AnchorPane>
